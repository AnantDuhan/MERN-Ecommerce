<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reset your Order Planning password</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f8fafc;
        font-family: Arial, Helvetica, sans-serif;
      }

      .container {
        max-width: 620px;
        margin: 40px auto;
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.08);
      }

      .header {
        background: linear-gradient(135deg, #4f8ef7, #2f80ed);
        text-align: center;
        padding: 48px 32px;
        color: #fff;
      }

      .logo {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 10px;
      }

      .header h1 {
        margin: 0;
        font-size: 30px;
      }

      .content {
        padding: 40px;
        color: #334155;
        font-size: 16px;
        line-height: 1.8;
      }

      .fallback-link {
        color: #2f80ed;
        font-weight: 600;
        text-decoration: underline;
      }

      .button {
        display: inline-block;
        margin: 30px 0;
        padding: 16px 34px;
        background: #2f80ed;
        color: #fff !important;
        text-decoration: none;
        border-radius: 12px;
        font-weight: 700;
      }

      .info {
        background: #eff6ff;
        border-left: 4px solid #2f80ed;
        padding: 18px;
        border-radius: 10px;
        margin: 28px 0;
      }

      .link {
        word-break: break-word;
        color: #2f80ed;
        font-size: 14px;
      }

      .footer {
        padding: 28px;
        background: #f8fafc;
        text-align: center;
        color: #64748b;
        font-size: 14px;
      }

      .footer a {
        color: #2f80ed;
        text-decoration: none;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <div class="logo">🛍️ Order Planning</div>

        <h1>Reset Your Password</h1>
      </div>

      <div class="content">
        <p>Hi <strong><%= user.name %></strong>,</p>

        <p>
          We received a request to reset the password for your
          <strong>Order Planning</strong> account.
        </p>

        <p>If this was you, click the button below to create a new password.</p>

        <!-- <div style="text-align:center; margin:32px 0;">
          <a
            href="<%= resetPasswordURL %>"
            style="
              background:#2F80ED;
              color:#ffffff;
              text-decoration:none;
              padding:16px 32px;
              border-radius:10px;
              font-weight:bold;
              font-size:16px;
              display:inline-block;
            "
          >
            Reset Password
          </a>
        </div> -->

        <table
          role="presentation"
          cellspacing="0"
          cellpadding="0"
          border="0"
          align="center"
          style="margin: 30px auto"
        >
          <tr>
            <td
              bgcolor="#2F80ED"
              style="border-radius: 10px; text-align: center"
            >
              <a
                href="<%= resetPasswordURL %>"
                style="
                  display: inline-block;
                  padding: 16px 34px;
                  font-size: 16px;
                  font-weight: bold;
                  color: #ffffff;
                  text-decoration: none;
                "
              >
                Reset Password
              </a>
            </td>
          </tr>
        </table>

        <div class="info">
          <strong>This reset link expires in 15 minutes.</strong>

          If it expires, simply request another password reset.
        </div>

        <p>
          If the button doesn't work, copy and paste this link into your
          browser:
        </p>

        <p>
          <a href="<%= resetPasswordURL %>" class="fallback-link">
            Reset your password
          </a>
        </p>

        <p>
          If you didn't request this password reset, you can safely ignore this
          email. Your password will remain unchanged.
        </p>
      </div>

      <div class="footer">
        Need help?

        <a href="mailto:<%= app.supportEmail %>"> <%= app.supportEmail %> </a>

        <br /><br />

        © <%= app.year %> <%= app.name %>. All rights reserved.
      </div>
    </div>
  </body>
</html>
